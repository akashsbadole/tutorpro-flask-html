# Payment Gateway Configuration
# Copy this file to .env.local and fill in your actual credentials

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox  # Use 'sandbox' for testing, 'live' for production

# Razorpay Configuration (for UPI payments)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Payment Settings
PAYMENT_CURRENCY=USD  # Default currency for payments
PAYMENT_TIMEOUT_MINUTES=30  # Payment timeout in minutes
REFUND_POLICY_DAYS=7  # Days after which refunds are not allowed
PAYOUT_PROCESSING_DAYS=3  # Days to process payouts
MIN_PAYOUT_AMOUNT=10.00  # Minimum payout amount
MAX_PAYMENT_AMOUNT=10000.00  # Maximum payment amount

# Security Settings
FRAUD_MAX_AMOUNT=5000.00  # Amount threshold for fraud detection
ALLOWED_COUNTRIES=US,CA,GB,IN  # Allowed countries for transactions
RATE_LIMIT_PAYMENT=10  # Max payment attempts per hour
RATE_LIMIT_PAYMENT_WINDOW=3600  # Time window for rate limiting (seconds)
RATE_LIMIT_REFUND=5  # Max refund attempts per hour
RATE_LIMIT_REFUND_WINDOW=3600  # Time window for refund rate limiting (seconds)

# Webhook Configuration
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Email Configuration for Payment Notifications
PAYMENT_NOTIFICATION_EMAIL=payments@yourdomain.com
REFUND_NOTIFICATION_EMAIL=refunds@yourdomain.com
PAYOUT_NOTIFICATION_EMAIL=payouts@yourdomain.com

# Database Configuration
PAYMENT_DB_ENCRYPTION_KEY=your_encryption_key_here  # Key for encrypting sensitive payment data