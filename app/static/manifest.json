{
  "name": "TutorPro - Online Learning Platform",
  "short_name": "TutorPro",
  "description": "Find the perfect tutor for your learning needs. Online tutoring platform with video sessions, courses, and more.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["education", "lifestyle", "productivity"],
  "icons": [
    {
      "src": "/static/images/icons/icon-192x192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    },
    {
      "src": "/static/images/icons/icon-512x512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ],
  "screenshots": [
    {
      "src": "/static/images/screenshots/desktop-home.webp",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "TutorPro home screen on desktop"
    },
    {
      "src": "/static/images/screenshots/desktop-home.webp",
      "sizes": "375x667",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "TutorPro home screen on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Find Tutors",
      "short_name": "Find Tutors",
      "description": "Search and discover tutors for your subjects",
      "url": "/tutors",
      "icons": [
        {
          "src": "/static/images/icons/shortcut-find-tutors.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "Access your learning dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/static/images/icons/shortcut-dashboard.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Book Session",
      "short_name": "Book",
      "description": "Book a tutoring session",
      "url": "/booking",
      "icons": [
        {
          "src": "/static/images/icons/shortcut-book.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+tutorpro",
      "url": "/handle-protocol?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/handle-file",
      "accept": {
        "application/pdf": [".pdf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "text/plain": [".txt"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
